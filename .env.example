STORYFORGE_PORT=8088
STORYFORGE_PUBLIC_ORIGIN=https://storyforge.example.com
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=your-application-audience-tag
STORYFORGE_ADMIN_EMAILS=your-google-email@example.com
